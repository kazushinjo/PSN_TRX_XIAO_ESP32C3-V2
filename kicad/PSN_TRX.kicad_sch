	(text "送信音声の I/Q 生成（Ver 2.0）: マイク → L15 LPF → IC2A（約 21 倍）→ C73・R59 → U3 の A2（受信中は S メーター用の受信音）→ 複素 FIR（16 kHz、127 タップ、300〜2700 Hz）→ PDM（D8 = Q、D10 = I。D10 は受信中は AGC の PWM）→ 2 段 RC（約 15 kHz）→ C48・C49。送信検出は D0 へ移動"
		(exclude_from_sim no)
		(at 829.564 654.05 0)
		(effects
			(font
				(size 1.27 1.27)
			)
			(justify left bottom)
		)
		(uuid "37b208ab-0cc0-4fb7-8faa-eb012ded7602")
	)
